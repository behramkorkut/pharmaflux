  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__terminal__.*|mcp__computer-use__.*|mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'for d in \"$CLAUDE_PROJECT_DIR\" \"$(git rev-parse --show-toplevel 2>/dev/null)\"; do f=\"$d/.claude/hooks/garde_fou.py\"; [ -f \"$f\" ] && exec python3 -I \"$f\"; done; echo \"garde-fou Pharmaflux introuvable : appel refusé\" >&2; exit 2'",
            "timeout": 30
          }
        ]
      }
    ]
  }
