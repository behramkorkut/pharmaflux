      "Bash(git push* *--no-verify*)",
      "Bash(git push* *--mirror*)",
      "Bash(git push* *--prune*)",
      "Bash(git commit* *--amend*)",
      "Bash(git commit* *--no-verify*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(git add -A)",
      "Bash(git add -A *)",
      "Bash(git add --all)",
      "Bash(git add --all *)",
      "Bash(git add .)",
      "Bash(git commit -a)",
      "Bash(git commit -a *)",
      "Bash(git commit -am)",
      "Bash(git commit -am *)",
      "Bash(git commit --all)",
      "Bash(git commit --all *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch --delete *)",
      "Bash(git switch* -f*)",
      "Bash(git switch* *--force*)",
      "Bash(git switch* *--discard-changes*)",
      "Bash(git config --unset*)",
      "Bash(git config --add*)",
      "Bash(git config --replace-all*)",
