      "Bash(git config --remove-section*)",
      "Bash(git config -e*)",
      "Bash(git config --edit*)",
      "Bash(git config --global*)",
      "Bash(git config --system*)",
      "Bash(git config --local*)",
      "Bash(git config --worktree*)",
      "Bash(git config --file*)",
      "Bash(git config -f *)",
      "Bash(git config set*)",
      "Bash(git config unset*)",
      "Bash(git config edit*)",
      "Bash(git config rename-section*)",
      "Bash(git config remove-section*)",
      "Bash(git config --get * *)",
      "Bash(git config core.*)",
      "Bash(git config user.*)",
      "Bash(git config remote.*)",
      "Bash(git config branch.*)",
      "Bash(git config alias.*)",
      "Bash(git config include*)",
      "Bash(git config credential.*)",
      "Bash(git config commit.*)",
      "Bash(git config gpg.*)",
      "Bash(git config http.*)",
      "Bash(git config url.*)",
      "Bash(git config safe.*)",
      "Bash(git -c *)",
      "Bash(git -C *)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh repo:*)",
      "Bash(gh api:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh workflow:*)",
      "Bash(gh run cancel:*)",
      "Bash(gh run delete:*)",
      "Bash(gh release:*)",
      "Bash(env -u* git*)",
      "Bash(env --unset* git*)",
      "Bash(unset *CLAUDE*)",
      "Bash(launchctl:*)",
      "Bash(crontab:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Bash(git push:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr comment:*)",
      "Bash(brew:*)",
      "Bash(sudo:*)"
