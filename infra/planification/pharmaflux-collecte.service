# Pharmaflux : un passage de collecte (télécharger, comparer, archiver,
# consigner). Unité système déclenchée par pharmaflux-collecte.timer, sous le
# compte dédié « pharmaflux », sans droits d'administration, sur un VPS que
# d'autres applications partagent.
# Installation et vérification : infra/planification/README.md.
#
# Chemins supposés (procédure du README) :
#   dépôt   /home/pharmaflux/pharmaflux                 (clone public, uv sync --frozen)
#   Python  /home/pharmaflux/.local/share/uv/python     (installé par uv, cible de .venv/bin/python)
#   archive /home/pharmaflux/pharmaflux-data            (PHARMAFLUX_DATA, hors dépôt)

[Unit]
Description=Pharmaflux : un passage de collecte des sources publiques (BDPM, Open Medic)
Documentation=https://github.com/behramkorkut/pharmaflux
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pharmaflux
Group=pharmaflux
WorkingDirectory=/home/pharmaflux/pharmaflux
Environment=PHARMAFLUX_DATA=/home/pharmaflux/pharmaflux-data
Environment=PYTHONUNBUFFERED=1
# Le script de l'environnement créé par « uv sync » : aucun outil à lancer au
# passage, uv ne sert qu'à l'installation et aux mises à jour.
ExecStart=/home/pharmaflux/pharmaflux/.venv/bin/pharmaflux collecte
SyslogIdentifier=pharmaflux-collecte

# Un passage dure quelques secondes ; le pire cas (quatorze téléchargements
# de 60 s, trois essais chacun) reste sous l'heure. Au-delà, on coupe pour
# ne jamais chevaucher le passage suivant.
TimeoutStartSec=55min

# Ressources : le VPS est partagé, un passage ne doit jamais gêner le reste.
# Mesuré sous l'unité durcie (mission 00) : pic mémoire 43 Mo, 2,35 s de CPU.
# Nice=10 : priorité CPU basse, l'ordonnanceur sert d'abord les autres.
Nice=10
# MemoryMax : six fois le pic mesuré ; au-delà, le passage est tué (puis
# relancé à l'heure suivante) plutôt que de pousser la machine en swap.
MemoryMax=256M
# CPUQuota : la moitié d'un cœur, soit un quart des deux cœurs du VPS ;
# le passage dure quelques secondes de plus, rien d'autre ne ralentit.
CPUQuota=50%
# IOSchedulingClass=idle : les lectures et écritures disque ne passent que
# quand personne d'autre n'en demande.
IOSchedulingClass=idle

# Durcissement : rien d'écrit en dehors de l'archive, aucun privilège.
# Objectif : score d'exposition « systemd-analyze security » sous 3 (mission 01).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# /home est remplacé par un tmpfs vide : le service ne voit, des dossiers
# personnels, que les trois chemins rendus visibles ci-dessous.
ProtectHome=tmpfs
# En lecture seule : le dépôt (code, .venv, .git pour la version du
# collecteur) et le Python installé par uv, cible du lien .venv/bin/python.
BindReadOnlyPaths=/home/pharmaflux/pharmaflux /home/pharmaflux/.local/share/uv/python
# En écriture : la seule archive.
BindPaths=/home/pharmaflux/pharmaflux-data
# UMask=0027 : ce que le passage crée (archives, manifeste) reste lisible par
# le groupe pharmaflux, dont le compte SSH qui rapatrie la copie, et par
# personne d'autre. (0077 casserait le rapatriement.)
UMask=0027
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# ProtectKernelLogs : aucun accès au journal du noyau (dmesg).
ProtectKernelLogs=true
# ProtectClock : l'horloge système n'est jamais modifiée ; le passage la lit.
ProtectClock=true
# ProtectHostname : le nom d'hôte ne sert à rien au collecteur.
ProtectHostname=true
# ProtectProc=invisible + ProcSubset=pid : dans /proc, le service ne voit que
# ses propres processus, ni ceux des autres applications ni /proc/sys.
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
# RestrictNamespaces : aucun espace de noms créé (conteneurs, montages, réseau).
RestrictNamespaces=true
LockPersonality=true
# MemoryDenyWriteExecute : aucune page mémoire à la fois écrite et exécutée ;
# CPython 3.12 sans JIT n'en a pas besoin. À retirer si le passage manuel
# échoue avec (vérification de beko sur le VPS, mission 01, palier 1).
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# CapabilityBoundingSet vide : aucune capacité, même si un binaire en portait.
CapabilityBoundingSet=
AmbientCapabilities=
# SystemCallArchitectures=native : pas d'appels système d'une autre
# architecture (32 bits sur un noyau 64 bits).
SystemCallArchitectures=native
# SystemCallFilter : les appels d'un service ordinaire, moins ceux qui sont
# privilégiés ou touchent aux limites de ressources (le collecteur lit,
# écrit des fichiers et parle HTTPS, rien d'autre). Un appel refusé échoue
# avec EPERM, visible dans le journal, plutôt que de tuer le processus net.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# RemoveIPC : aucun objet IPC System V ou POSIX ne survit au passage.
RemoveIPC=true
